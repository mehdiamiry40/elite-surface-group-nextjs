{
  "name": "elite-surface-group-nextjs",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.23.2 <23",
    "npm": "10.9.8"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node --experimental-strip-types scripts/check-env.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts",
    "generate-lcp-blur": "node scripts/generate-lcp-blur.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "a11y": "node scripts/a11y-test.mjs",
    "analytics-test": "node scripts/analytics-test.mjs",
    "enquiry-test": "node scripts/enquiry-test.mjs",
    "contact-redis-test": "node --experimental-strip-types --test scripts/contact-redis-test.mjs",
    "contact-status-check": "node scripts/contact-status-check.mjs",
    "bundle-budget": "node scripts/check-bundle-budget.mjs",
    "link-check": "node scripts/link-check.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run bundle-budget"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "svix": "^2.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "playwright": "^1.57.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.25",
      "sharp": "0.35.4"
    },
    "js-yaml": "4.3.2"
  }
}
