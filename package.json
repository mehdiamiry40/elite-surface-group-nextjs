{
  "name": "elite-surface-group-nextjs",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": ">=22.14 <23"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-env.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --experimental-strip-types --test src/lib/contact-security.test.ts",
    "smoke": "node scripts/smoke-test.mjs",
    "a11y": "node scripts/a11y-test.mjs",
    "bundle-budget": "node scripts/check-bundle-budget.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run bundle-budget"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "axe-core": "^4.11.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "playwright": "^1.57.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    }
  }
}
