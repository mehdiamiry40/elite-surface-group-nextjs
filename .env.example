# Contact-form delivery (Resend). Without RESEND_API_KEY the form falls back
# to opening the visitor's mail client, which silently loses enquiries —
# except during `npm run dev`, which captures the enquiry in the server log
# so the quote flow can be tested without secrets.
#
# CONTACT_FROM_EMAIL is optional. The runtime defaults to the business domain
# below, which Resend can send from once its DNS records are added in the
# Resend dashboard. A Gmail address cannot send: gmail.com is not a domain
# anyone but Google can verify, so Resend rejects it and every enquiry fails.
# `npm run prebuild` warns locally and blocks Vercel Production builds when
# RESEND_API_KEY is missing or CONTACT_FROM_EMAIL is a public-mailbox sender.
#
# CONTACT_TO_EMAIL is optional; it defaults to the published inbox, and a value
# still pointing at the retired @elitesurfacegroup.com.au mailbox is ignored.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Elite Surface Group <info@elitesurfacegroup.com.au>
CONTACT_TO_EMAIL=elite.surfacegroup@gmail.com

# Optional shared contact rate limiting (Upstash Redis REST).
# When unset, the API falls back to a per-instance in-memory limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional outside Vercel Production: turn the warning into a hard build error.
REQUIRE_CONTACT_DELIVERY=

# Emergency-only production override. Leave unset during normal operation.
ALLOW_UNCONFIGURED_CONTACT=

# Optional. Adds an extra allowed origin for contact-form submissions; useful
# when the site is served from a domain other than its canonical one.
NEXT_PUBLIC_SITE_URL=https://elitesurfacegroup.com.au
